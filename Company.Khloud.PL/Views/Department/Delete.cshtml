@model Department
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Department</h1>
<br />
<br />

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">


    
    

    <partial name="DepartmentPartialView/_DetailsDeletePartialView" />
